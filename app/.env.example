# Optional Regrid parcel API token (https://regrid.com/api). Leave blank to use the free county ArcGIS endpoints only.
REGRID_TOKEN=

# Basemap for display only (never measured from): naip = USGS/USDA NAIP imagery (public domain), osm = OpenStreetMap (development only).
NEXT_PUBLIC_BASEMAP=naip

# Product name shown in the UI and on proposal PDFs.
NEXT_PUBLIC_APP_NAME=Fenceline
